{
	"extends": "./tsconfig.json",
	"include": [
		"playwright.config.ts",
		"e2e/**/*.ts",
		"app/shell/destinations.ts",
		"app/auth/code.ts"
	],
	"compilerOptions": {
		"composite": true,
		"strict": true,
		"types": ["node"],
		"lib": ["DOM", "DOM.Iterable", "ES2024"],
		"target": "ES2024",
		"module": "ES2022",
		"moduleResolution": "bundler"
	}
}
