{
	"extends": "./tsconfig.json",
	"include": [
		"playwright.config.ts",
		"e2e/**/*.ts",
		"app/shell/destinations.ts",
		"app/integrations/paths.ts",
		"app/contractors/paths.ts",
		"app/activity/paths.ts",
		"app/projects/projects.ts",
		"app/lib/names.ts",
		"app/invoices/paths.ts",
		"app/auth/code.ts",
		"app/auth/person-name.ts",
		"app/shell/color-scheme.server.ts",
		"app/platform/paths.ts"
	],
	"compilerOptions": {
		"composite": true,
		"strict": true,
		"types": ["node"],
		"lib": ["DOM", "DOM.Iterable", "ES2024"],
		"target": "ES2024",
		"module": "ES2022",
		"moduleResolution": "bundler"
	}
}
