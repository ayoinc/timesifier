/**
 * Wrangler configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 * Bindings are added by the cards that need them; see docs/architecture.md.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "timesifier",
	"main": "./workers/app.ts",
	// Selected by create-cloudflare on the day the project was scaffolded.
	"compatibility_date": "2026-11-09",
	"compatibility_flags": ["nodejs_compat"],
	// Production is served only on its own domain. Wrangler creates the DNS
	// records for these two hostnames and touches no other record in the zone.
	"workers_dev": false,
	"routes": [
		{ "pattern": "timesifier.com", "custom_domain": true },
		{ "pattern": "www.timesifier.com", "custom_domain": true }
	],
	// Tells the Worker it is production: it then answers only on timesifier.com.
	// See workers/canonical-host.ts.
	"vars": { "ENVIRONMENT": "production" },
	// Each pull request gets a preview on workers.dev. Without this line a preview
	// has no URL, because turning workers_dev off turns preview URLs off too. It
	// also gives every production version a workers.dev address; the Worker
	// answers 404 there.
	"preview_urls": true,
	// Previews do not inherit production settings; preview-safe bindings go here.
	// https://developers.cloudflare.com/workers/previews/configuration/
	// Every preview shares one database. wrangler.preview-migrations.jsonc names the
	// same database, so the pipeline can migrate it; change the two together.
	"previews": {
		"vars": { "ENVIRONMENT": "preview" },
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "timesifier-preview",
				"database_id": "f0f2fead-b929-44ff-8165-dba382743beb"
			}
		]
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 }
	},
	"upload_source_maps": true,
	// Production database, created with `--jurisdiction eu`; see docs/architecture.md.
	// Schema changes are the SQL files in migrations/, generated by `pnpm db:generate`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "timesifier",
			"database_id": "b6ab20fa-794f-43a5-bd7e-d80b7eca88db",
			"migrations_dir": "migrations"
		}
	]
}
