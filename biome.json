{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/.agents",
			"!**/pnpm-lock.yaml",
			"!**/worker-configuration.d.ts",
			"!app/styles/tokens.css"
		]
	},
	"formatter": { "indentStyle": "tab", "lineWidth": 100 },
	"css": { "parser": { "tailwindDirectives": true } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": { "noExplicitAny": "error" },
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"~/db/schema": "Import from ~/db. Tables with an organisation_id are reached only through organisationScope.",
							"~/db/scope": "Import organisationScope from ~/db."
						},
						"patterns": [
							{
								"group": ["**/db/schema", "**/db/scope"],
								"message": "Import from ~/db. Tables with an organisation_id are reached only through organisationScope."
							}
						]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"app/db/**",
				"app/auth/**",
				"test/db/**",
				"test/node/**",
				"test/claims.test.ts",
				"drizzle.config.ts"
			],
			"linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
		}
	],
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
