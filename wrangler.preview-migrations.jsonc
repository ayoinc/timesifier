/**
 * Used by the pipeline only, to apply migrations to the database that previews
 * share. It names the same database as `previews.d1_databases` in wrangler.jsonc;
 * change the two together.
 * https://developers.cloudflare.com/workers/previews/resources/#d1-migrations
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"d1_databases": [
		{
			"binding": "PREVIEW_DB",
			"database_name": "timesifier-preview",
			"database_id": "f0f2fead-b929-44ff-8165-dba382743beb",
			"migrations_dir": "migrations"
		}
	]
}
