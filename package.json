{
	"name": "timesifier",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"deploy": "pnpm run build && wrangler deploy",
		"preview": "pnpm run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"isbot": "^5.1.36",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@cloudflare/vite-plugin": "^1.68.0",
		"@cloudflare/vitest-plugin": "^1.6.1",
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"vitest": "^4.1.12",
		"wrangler": "^4.159.0"
	}
}
