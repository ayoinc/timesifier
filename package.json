{
	"name": "timesifier",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"lint": "biome check . && pnpm check:tokens",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"tokens": "node scripts/tokens.ts",
		"check:tokens": "node scripts/check-tokens.ts",
		"preview": "pnpm run build && vite preview",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"better-auth": "1.7.19",
		"drizzle-orm": "^0.45.4",
		"isbot": "^5.1.36",
		"react": "^19.2.8",
		"react-aria": "3.53.1",
		"react-aria-components": "1.22.1",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.1",
		"react-stately": "3.51.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "^2.6.6",
		"@cloudflare/vite-plugin": "^1.68.0",
		"@cloudflare/vitest-plugin": "^1.6.1",
		"@fontsource-variable/roboto-flex": "5.3.0",
		"@material/material-color-utilities": "0.4.0",
		"@playwright/test": "1.65.0",
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"vitest": "^4.1.12",
		"wrangler": "4.159.0"
	}
}
