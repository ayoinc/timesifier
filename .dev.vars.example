# Local secrets for `pnpm dev`. Copy to `.dev.vars` (ignored by git) and
# `chmod 600 .dev.vars`. Names only here; never commit a value.
# See docs/security.md, "Secrets".

# Signs session cookies. Any random value of 32 characters or more:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Turnstile. Locally, use Cloudflare's published test keys, which are not
# secrets: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#   secret key that passes every check: 1x0000000000000000000000000000000AA
#   site key that passes every check:   1x00000000000000000000AA
TURNSTILE_SECRET_KEY=
# Public, and set in wrangler.jsonc for production; this line overrides it locally.
TURNSTILE_SITE_KEY=
